{
  "name": "ruixing",
  "private": true,
  "version": "0.1.0",
  "description": "PinkRose 本地优先的 AI 对话式修图应用",
  "author": "PinkRose",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node server/index.ts",
    "search:mcp": "node server/searchMcpEntry.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/prerender.mjs",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:run": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder",
    "desktop:package": "electron-builder",
    "desktop:smoke": "node scripts/check-desktop.mjs",
    "start": "node server/index.ts",
    "camera:bridge": "node scripts/camera-bridge.ts",
    "camera:probe": "node scripts/camera-bridge.ts --probe",
    "preview": "vite preview",
    "test": "node scripts/test-all.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check:layout": "node scripts/check-mobile-layout.mjs",
    "check:touch": "node scripts/check-touch-targets.mjs",
    "check:tablet": "node scripts/check-tablet-layout.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:duotone": "node scripts/check-duotone.mjs",
    "check:grading": "node scripts/check-color-grading.mjs",
    "check:color-noise": "node scripts/check-color-noise.mjs",
    "check:bw": "node scripts/check-bw-mix.mjs",
    "check:sharpen": "node scripts/check-sharpen.mjs",
    "check:lut": "node scripts/check-lut.ts",
    "check:safari": "node scripts/check-safari.mjs",
    "check:smooth": "node scripts/check-smooth.mjs",
    "check:perspective": "node scripts/check-perspective.mjs",
    "check:tilt-shift": "node scripts/check-tilt-shift.mjs",
    "check:focus-bracket": "node scripts/check-focus-bracket.mjs",
    "check:clipping": "node scripts/check-clipping.mjs",
    "check:connected-select": "node scripts/check-connected-select.mjs",
    "check:luminance": "node scripts/check-luminance-mask.mjs",
    "check:bursts": "node scripts/check-bursts.mjs",
    "check:portrait": "node scripts/check-portrait-faces.mjs",
    "check:heic": "node scripts/check-heic-export.mjs",
    "check:import": "node scripts/check-import-fallback.mjs",
    "check:live-photo": "node scripts/check-live-photo.mjs",
    "check:file-share": "python scripts/check-file-share.py",
    "check:camera-live": "node scripts/check-camera-live.mjs",
    "check:remote-camera-ui": "node scripts/check-remote-camera-ui.mjs",
    "check:lens": "node scripts/check-lens.mjs",
    "check:lut-export": "node scripts/check-lut-export.mjs",
    "check:copy": "node scripts/dump-copy.mjs",
    "check:color": "node scripts/check-color-profile.ts",
    "check:color-sample": "node scripts/check-color-sampler.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:raw-preview": "node scripts/check-raw-preview.mjs",
    "check:source-profile": "node scripts/check-source-profile.ts",
    "probe:p3": "node scripts/check-p3-capability.mjs"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "lucide-react": "1.49.0",
    "piexifjs": "^1.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/piexifjs": "^1.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}

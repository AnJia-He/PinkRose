/* index.wxss —— 空态 / 编辑态（视觉照 spec §4.1；色号一律走 app.wxss 的令牌） */

/* 一屏到底、不滚：height 固定 100vh、状态栏的 padding（wxml 里那行 inline style）
   算在这 100vh 里（box-sizing），里面两态再用 100% 填满 ——
   否则「100vh + 状态栏」会比屏幕高出一截（空态多出一条能滚的空白、编辑态照片底边出屏）。 */
.page {
  height: 100vh;
  box-sizing: border-box;
}

/* ── 空态 ─────────────────────────────────────────────────────────────
   小皇帝徽章标（黑圆盘 + 白图）+ 「PinkRose」+ 一句话，下面两颗大按钮。
   竖中偏上：像电脑版欢迎屏那样，视线自然先落在标上。 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  height: 100%; /* 填满 .page 的内容盒（已扣掉状态栏那截） */
  padding: 0 64rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}

.brand-mark {
  width: 160rpx;
  height: 160rpx;
  margin-top: 30vh;
}

.brand-name {
  margin-top: 28rpx;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.empty-sub {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 28rpx;
}

/* ── 那两颗大按钮（空态最要人点的地方）─────────────────────────────
   药丸形（-r-pill）；主按钮 = 薄荷底 + 深青字（--accent-ink，见 app.wxss 注释）。 */
.big-btn {
  width: 100%;
  margin-top: 88rpx;
  padding: 26rpx 0;
  background: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: var(--r-pill);
  color: var(--accent-ink);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.big-btn.ghost {
  margin-top: 24rpx;
  background: transparent;
  border-color: var(--line-2);
  color: var(--text);
  font-weight: 400;
}

/* ── 编辑态（任务 4 起才有内容；顶栏先按说好的三格摆好）────────────── */
/* 右边距不写死：wxml 里 inline 的那条 padding-right 是给微信胶囊让位的量
   （页面数据 topbarPadRight 算出来的），胶囊右槽不让人就看不见。 */
.topbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.tb-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 触控面：文字本身太小（「保存」才 60rpx 宽），撑到和顶栏一样高、再加一圈横向内边距
   （左边 44pt 那条线），再用负 margin 把多出来的边距拉回去 —— 文字位置不动。 */
.tb-left,
.tb-right {
  position: relative; /* 压在标题那层上面，可点 */
  z-index: 1;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  margin: 0 -20rpx;
  color: var(--muted);
  font-size: 30rpx;
}

/* 「保存」是这条顶栏上**唯一要人点**的东西 —— 颜色按 mock 给主色；
   「换一张」保持 muted（它只是退路，别和主按钮抢）。 */
.tb-right {
  color: var(--accent-400);
}

.edit {
  display: flex;
  flex-direction: column;
  height: calc(100% - 88rpx); /* 顶栏那 88rpx 之外剩下的都归照片 */
}

/* 照片区：照片（画布）等比居中。
   盒子大小是 ts 里按照片与这块地方算出来的（stageW/stageH，inline style）——
   这里只管"把它放在正中间"。⚠️ `type="webgl2"` 的画布是正常排版的元素，
   flex 居中它收得到（老的 type 画布才不吃这套）。 */
.stage-area {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage {
  display: block;
}

/* ── 风格栏（Task 6）─────────────────────────────────────────────────
   横滑一条，格子 = 真渲染的小图 + 名字（画法见 lib/image/thumbs.ts）。
   格宽跟着照片比例走（横图宽、竖图窄），所以这条**不许**给格子定死宽度。 */
.styles {
  /* 小图高度 —— 渲染那边按 128 物理 px 画（thumbs.ts 的 RENDER_H），375 宽的屏上
     128rpx = 64px，正好是一半。⚠️ 这个值同时喂给背景切片（wxml 里
     `background-size: … var(--thumb-h)`），改它一处就够，别在别处再写一遍。 */
  --thumb-h: 128rpx;
  /* ⚠️ 高度**必须定死**（= 上下内边距 36 + 小图 128+4 边框 + 名字 8+30，刚好 206）：
     照片区的尺寸是照这张条子的高度量出来再定画布大小的，而 sprite 要过一会儿才画好 ——
     条子若按内容撑高，"空着"和"装满了"差出 90px，照片就会盖住这一排
     （2026-10-12 真机截图抓到过：小图被照片压扁在屏幕底边）。改这里的数，下面
     三处的和必须还是它，否则又会压扁。 */
  height: 206rpx;
  box-sizing: border-box;
  display: flex; /* 配 enable-flex 才成立（scroll-view 的 flex 布局要两样都写） */
  flex: none; /* 别被上面照片区挤扁 */
  padding: 16rpx 32rpx 20rpx;
}

.style-cell {
  flex: none; /* 不许收缩 —— 横滑靠的就是它们原宽超出屏幕 */
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

/* 小图：**外框长在图上、名字露在框外**（和电脑版 `.rail-tile` 的 `.rail-shot` 同款）。
   底用 `--raised`：图没到位时它就是一块占位，不会像"加载失败"。
   ⚠️ 留 content-box（默认）：宽/高就是切片尺寸，2rpx 的边框长在外面 ——
   改 border-box 会把边框那圈从图里吃掉，切片跟着歪。 */
.style-thumb {
  height: var(--thumb-h);
  flex: none; /* 条子高度算进来就这么多，不许被压扁（压扁 = 小图上下被裁一刀） */
  background-color: var(--raised);
  background-repeat: no-repeat; /* 尺寸正好等于盒子，防亚像素漏出隔壁格 */
  border: 2rpx solid var(--line);
  border-radius: var(--r-sm);
}

/* 名字：一行、居中，**允许比格子宽**（4 个字的名字比竖图格子宽一点）。
   溢出那几 rpx 落在格子间距（20rpx）里，撞不到旁边的名字 —— 比截断成
   「日系通…」强，也比把格子撑宽（那样小图就不等宽了）强。 */
.style-name {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 30rpx; /* 定死行高：条子那 206rpx 是按 30 算的（小数行高会对不上） */
  white-space: nowrap;
}

/* 选中：主色只花在这一处（框 + 名字），和电脑版 `.rail-tile.on` 同一身衣服 */
.style-cell.on .style-thumb {
  border-color: var(--accent);
}

.style-cell.on .style-name {
  color: var(--accent);
}

/* ── ★ Task 12 · 生成中蒙层 + 撤销 ───────────────────────────────────
   两个都贴在**照片本身**上 —— 外面那层 .stage-wrap 正好等于照片显示尺寸
   （inline 的 stageW/stageH，wxml 里包的壳），所以这里全用 inset 0 / 右下角定位。 */
.stage-wrap {
  position: relative;
}

/* 蒙层（spec §4.3）：暗化 + 转圈 + 秒表 + 停止，四样一起摆在照片正中。
   暗度取 .45：要够文字立得住，又要看得见"还是那张照片"（电脑版生成暗罩
   .canvas-veil 是 .22、换图浮层 .55，这里是有字有按钮的蒙层，取中间）。 */
.gen-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

/* 转圈：一条边亮色的圈，转起来（纯 CSS，不引图标） */
@keyframes gen-spin {
  to { transform: rotate(360deg); }
}

.gen-spinner {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border: 6rpx solid var(--line-3);
  border-top-color: var(--accent-400);
  border-radius: 50%;
  animation: gen-spin 0.9s linear infinite;
}

.gen-text {
  margin-top: 28rpx;
  color: var(--text);
  font-size: 28rpx;
}

/* 「停止」：描边药丸 —— 蒙层上唯一的可点项，做得像按钮但不抢主色
   （主色留给发送箭头那一颗） */
.gen-stop {
  margin-top: 40rpx;
  padding: 14rpx 56rpx;
  border: 2rpx solid var(--line-3);
  border-radius: var(--r-pill);
  color: var(--text);
  font-size: 28rpx;
}

/* 「撤销」：照片右下角（spec §4.3）。实心 --panel 底 —— 不管照片亮暗都立得住 */
.undo-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 14rpx 36rpx;
  background: var(--panel);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-pill);
  color: var(--text);
  font-size: 26rpx;
}

/* ── ★ Task 12 · 说一句（输入条 + 浮条）────────────────────────────── */
.say-bar {
  position: relative; /* 浮条挂它正上方（bottom: 100% + …） */
  flex: none;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}

/* 浮条（spec §4.2）：模型那句话，输入条正上方一条，5 秒后自动淡出（时序在 ts）。
   绝对定位 —— 出/没出都不挪下面的版面。 */
.say-bubble {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(100% + 16rpx);
  z-index: 10;
  padding: 20rpx 28rpx;
  background: var(--raised);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-md);
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.5;
}

.say-row {
  display: flex;
  align-items: center;
}

/* 输入胶囊：和风格栏/大按钮同族的圆角语言（-r-pill） */
.say-pill {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: var(--panel);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-pill);
}

.say-input {
  flex: 1;
  height: 100%;
  color: var(--text);
  font-size: 28rpx;
}

/* placeholder 要单独一个类喂给 input 的 placeholder-class（inline 的 placeholder
   文字不吃普通后代选择器） */
.say-ph {
  color: var(--muted-2);
}

/* 忙态那句「在想…」/「正在修…」 */
.say-thinking {
  color: var(--muted);
  font-size: 28rpx;
}

/* 发送箭头：--accent-400 底、--accent-ink 字（照 mock） */
.say-send {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-left: 20rpx;
  background: var(--accent-400);
  border-radius: 50%;
  color: var(--accent-ink);
  font-size: 40rpx;
  font-weight: 600;
}

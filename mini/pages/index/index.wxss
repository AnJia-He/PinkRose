/* index.wxss —— 空态 / 编辑态（视觉照 spec §4.1；色号一律走 app.wxss 的令牌） */

/* 一屏到底、不滚：height 固定 100vh、状态栏的 padding（wxml 里那行 inline style）
   算在这 100vh 里（box-sizing），里面两态再用 100% 填满 ——
   否则「100vh + 状态栏」会比屏幕高出一截（空态多出一条能滚的空白、编辑态照片底边出屏）。 */
.page {
  height: 100vh;
  box-sizing: border-box;
}

/* ── 空态 ─────────────────────────────────────────────────────────────
   小皇帝徽章标（黑圆盘 + 白图）+ 「PinkRose」+ 一句话，下面两颗大按钮。
   竖中偏上：像电脑版欢迎屏那样，视线自然先落在标上。 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  height: 100%; /* 填满 .page 的内容盒（已扣掉状态栏那截） */
  padding: 0 64rpx;
  /* ★ Task 16：这里**不再**加 env(safe-area-inset-bottom)。底部安全区让给 tabBar ——
     v1.1 起这页是 tab 页，页面视口底 = tabBar 顶（原生 tabBar 自己压在 home
     indicator 上），页面再补 env() 就是往 tabBar 上方凭空多留 34px 死区
     （实测量法见下面 .say-bar 那条）。 */
  padding-bottom: 96rpx;
}

.brand-mark {
  width: 160rpx;
  height: 160rpx;
  margin-top: 30vh;
}

.brand-name {
  margin-top: 32rpx; /* ★ Task 15（F6）：28→32rpx（≈16.6px），对齐电脑版 .welcome-mark 的 16px */
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.empty-sub {
  margin-top: 24rpx; /* ★ Task 15（F6）：16→24rpx（≈12.5px），对齐电脑版 .welcome-lede 的 12px */
  color: var(--muted);
  font-size: 28rpx;
}

/* ── 那两颗大按钮（空态最要人点的地方）─────────────────────────────
   药丸形（-r-pill）；主按钮 = 薄荷底 + 深青字（--accent-ink，见 app.wxss 注释）。 */
.big-btn {
  width: 100%;
  margin-top: 88rpx;
  padding: 26rpx 0;
  background: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: var(--r-pill);
  color: var(--accent-ink);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* 微信 <button> 自带一层 ::after 伪元素描边 —— 不清掉，药丸边上会多一圈
   默认灰线（M2，2026-10-12 全支大审）。页面上的按钮全是 .big-btn，一条就够。 */
.big-btn::after {
  border: none;
}

.big-btn.ghost {
  margin-top: 24rpx;
  background: transparent;
  border-color: var(--line-2);
  color: var(--text);
  font-weight: 400;
}

/* ── 编辑态（任务 4 起才有内容；顶栏先按说好的三格摆好）────────────── */
/* 右边距不写死：wxml 里 inline 的那条 padding-right 是给微信胶囊让位的量
   （页面数据 topbarPadRight 算出来的），胶囊右槽不让人就看不见。 */
.topbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.tb-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 触控面：文字本身太小（「保存」才 60rpx 宽），撑到和顶栏一样高、再加一圈横向内边距
   （左边 44pt 那条线），再用负 margin 把多出来的边距拉回去 —— 文字位置不动。 */
.tb-left,
.tb-right {
  position: relative; /* 压在标题那层上面，可点 */
  z-index: 1;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  margin: 0 -20rpx;
  color: var(--muted);
  font-size: 30rpx;
}

/* 「保存」是这条顶栏上**唯一要人点**的东西 —— 颜色按 mock 给主色；
   「换一张」保持 muted（它只是退路，别和主按钮抢）。 */
.tb-right {
  color: var(--accent-400);
}

.edit {
  display: flex;
  flex-direction: column;
  height: calc(100% - 88rpx); /* 顶栏那 88rpx 之外剩下的都归照片 */
}

/* 照片区：照片（画布）等比居中。
   盒子大小是 ts 里按照片与这块地方算出来的（stageW/stageH，inline style）——
   这里只管"把它放在正中间"。⚠️ `type="webgl2"` 的画布是正常排版的元素，
   flex 居中它收得到（老的 type 画布才不吃这套）。 */
.stage-area {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 照片本身（画布）—— ★ Task 15 照片舞台感（评审 P1-1）：给它"相纸边 + 影子"，
   让照片读起来是**压在卡纸上的相纸**，不是直接坐在黑底上的色块。
   两处值都是**镜像电脑版**的（`src/styles.css` 的 `.canvas` 与 `--photo-shadow`，
   不是自造）：那边是 `0 0 0 1px var(--photo-edge)` + `0 4px 14px rgba(0,0,0,.5)`
   （深色半）—— 1px→2rpx、4px→8rpx、14px→28rpx（×1.922 取偶）。
   ⚠️ 深底上那圈浅边治的是"夜景/暗调照片糊进底里"（正是这个产品的常客）。
   ⚠️ 上下那两道 24rpx 呼吸**不在这里**——那是 ts 的 fitK 按可用高扣出来的
   （CSS padding 会被量盒吃进去，见 index.ts 的 STAGE_GAP_RPX 注释）。
   ⚠️ 真机验收项：webgl2 画布上 border-radius 裁不裁得动、box-shadow 生不生效
   （模拟器看不准；不裁就撤 radius、只留边+影）——见 README「设计打磨轮」那节。 */
.stage {
  display: block;
  border-radius: 16rpx;
  box-shadow: 0 0 0 2rpx var(--photo-edge), 0 8rpx 28rpx rgba(0, 0, 0, .5);
}

/* ── 风格栏（Task 6）─────────────────────────────────────────────────
   横滑一条，格子 = 真渲染的小图 + 名字（画法见 lib/image/thumbs.ts）。
   格宽跟着照片比例走（横图宽、竖图窄），所以这条**不许**给格子定死宽度。 */
.styles {
  /* 小图高度 —— 渲染那边按 128 物理 px 画（thumbs.ts 的 RENDER_H），375 宽的屏上
     128rpx = 64px，正好是一半。⚠️ 这个值同时喂给背景切片（wxml 里
     `background-size: … var(--thumb-h)`），改它一处就够，别在别处再写一遍。 */
  --thumb-h: 128rpx;
  /* ⚠️ 高度**必须定死**（= 上下内边距 36 + 小图 128+4 边框 + 名字 8+30，刚好 206）：
     照片区的尺寸是照这张条子的高度量出来再定画布大小的，而 sprite 要过一会儿才画好 ——
     条子若按内容撑高，"空着"和"装满了"差出 90px，照片就会盖住这一排
     （2026-10-12 真机截图抓到过：小图被照片压扁在屏幕底边）。改这里的数，下面
     三处的和必须还是它，否则又会压扁。 */
  height: 206rpx;
  box-sizing: border-box;
  display: flex; /* 配 enable-flex 才成立（scroll-view 的 flex 布局要两样都写） */
  flex: none; /* 别被上面照片区挤扁 */
  padding: 16rpx 32rpx 20rpx;
}

.style-cell {
  flex: none; /* 不许收缩 —— 横滑靠的就是它们原宽超出屏幕 */
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

/* 小图：**外框长在图上、名字露在框外**（和电脑版 `.rail-tile` 的 `.rail-shot` 同款）。
   底用 `--raised`：图没到位时它就是一块占位，不会像"加载失败"。
   ⚠️ 留 content-box（默认）：宽/高就是切片尺寸，2rpx 的边框长在外面 ——
   改 border-box 会把边框那圈从图里吃掉，切片跟着歪。 */
.style-thumb {
  height: var(--thumb-h);
  flex: none; /* 条子高度算进来就这么多，不许被压扁（压扁 = 小图上下被裁一刀） */
  background-color: var(--raised);
  background-repeat: no-repeat; /* 尺寸正好等于盒子，防亚像素漏出隔壁格 */
  border: 2rpx solid var(--line);
  border-radius: var(--r-sm);
}

/* 名字：一行、居中，**允许比格子宽**（4 个字的名字比竖图格子宽一点）。
   溢出那几 rpx 落在格子间距（20rpx）里，撞不到旁边的名字 —— 比截断成
   「日系通…」强，也比把格子撑宽（那样小图就不等宽了）强。 */
.style-name {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx; /* ★ Task 15（F4）：22→24rpx（12.5px ≈ 电脑版 12 档）；之前是全页唯一"梯子外"的字号 */
  line-height: 30rpx; /* 定死行高：条子那 206rpx 是按 30 算的（小数行高会对不上）—— 字号改了它也**不许动** */
  white-space: nowrap;
}

/* 选中：主色只花在这一处（框 + 名字），和电脑版 `.rail-tile.on` 同一身衣服 */
.style-cell.on .style-thumb {
  border-color: var(--accent);
}

.style-cell.on .style-name {
  color: var(--accent);
}

/* ── ★ Task 14 · 对话区（spec §4.2 的 2026-10-13 修订块）───────────────
   说过的话（me）/ 小皇帝回的（ai）/ 系统小字（note）都留在这条消息流里 ——
   wxml 里排在风格栏和输入条**之间**，**正常排版流**的一条 scroll-view。
   ⚠️ 绝不许 absolute 叠到照片/画布上：真机上叠 webgl canvas 的可点 view 收不到
   点击（README「已知平台行为」）——「停止」跟着生成那颗气泡走也就同样在画布外。
   高度：max-height 封顶（照片必须仍是屏幕上最大的一块 —— 照片区是 flex:1，
   对话区长高它就矮；画布的显示尺寸由 ts 的 fitStage() 跟着重算）。
   **不做入场动画**（整体要"安静"，别抢照片）。 */
.msgs {
  flex: none;
  box-sizing: border-box;
  max-height: 400rpx;
  padding: 8rpx 32rpx 0; /* 左右与全页对齐（32rpx） */
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx; /* 条目间距 —— ★ Task 15（F3）：16→32rpx，对齐电脑版节奏表「对话块与块 16px」 */
}

/* 「我说的」：右对齐气泡，★ 修复轮 F5 **降调**——--accent-tint 底 + --accent-300 字
   （满血薄荷 --accent-400 留给"可点/选中"：发送箭头、点亮的小图；气泡抢同一颜色会
   分不清谁可点）。右对齐 + AI 徽章照旧。 */
.msg.me {
  justify-content: flex-end;
}

.msg.me .msg-body {
  max-width: 78%;
  padding: 22rpx 28rpx; /* ★ Task 15（F3）：12/24→22/28rpx（≈11.4/14.6px），对齐电脑版 .bubble 的 11/15px */
  background: var(--accent-tint);
  border-radius: var(--r-md);
  color: var(--accent-300);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 「小皇帝回的」：左对齐气泡 + 徽章标，--raised 底 + 2rpx --line-2 描边 */
.msg.ai .msg-body {
  display: flex;
  align-items: center;
  max-width: 78%;
  padding: 22rpx 28rpx; /* ★ Task 15（F3）：同 .msg.me 那档 */
  background: var(--raised);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-md);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 徽章标：小皇帝黑圆盘。40~48rpx 的小圆，别喧宾夺主（和气泡首行对齐） */
.msg-badge {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin: 4rpx 12rpx 0 0;
  border-radius: 50%;
}

/* 转圈：一条边亮色的圈，转起来（纯 CSS，不引图标；从旧蒙层的生成转圈挪来改的名） */
@keyframes msg-spin {
  to { transform: rotate(360deg); }
}

.msg-spinner {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  margin-right: 16rpx;
  border: 5rpx solid var(--line-3);
  border-top-color: var(--accent-400);
  border-radius: 50%;
  animation: msg-spin 0.9s linear infinite;
}

/* 气泡里的「停止」：胶囊、muted 描边风（和「撤销」同族，不抢主色）。
   ★ 修复轮 F2：加大到 80rpx 高（≈41.6px，和发送箭头同尺寸档）——
   停止出现时气泡略胀，那正是"停止可用"的时刻，可接受。 */
.msg-stop {
  flex: none;
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-left: 20rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-pill);
  color: var(--muted);
  font-size: 26rpx;
}

/* 系统小字：居中的一行（点风格「套用了「…」」、结果作废这类通报） */
.msg.note {
  justify-content: center;
  margin: 8rpx 0;
}

.msg.note .msg-body {
  padding: 0 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

/* 长文本兜底断行（说过的话里可能有长英文 / 链接，别把气泡撑出屏幕） */
.msg-text {
  word-break: break-word;
}

/* ── ★ Task 12 · 说一句（输入条）───────────────────────────────────── */
.say-bar {
  flex: none;
  /* ★ Task 16（tabBar 视口逼出的适配）：原来底部是 calc(20rpx + env(safe-area-inset-bottom))，
     那是给"页面底 = 手机屏幕底"算的（清 home indicator）。v1.1 起页面视口底 = tabBar 顶，
     安全区由原生 tabBar 自己处理 —— 再补 env() 实测多留 34.3px 死区（say-bar 高 94.6，
     本应 60.2；照片因此矮了 34px）。去掉 env 后输入条离 tabBar 恰好 20rpx，
     和原设计"离屏底 20rpx"是同一条规矩。 */
  padding: 16rpx 32rpx 20rpx;
}

.say-row {
  display: flex;
  align-items: center;
}

/* 输入胶囊：和风格栏/大按钮同族的圆角语言（-r-pill） */
.say-pill {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: var(--panel);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-pill);
}

.say-input {
  flex: 1;
  height: 100%;
  color: var(--text);
  font-size: 28rpx;
  /* ⚠️ <input> 不吃父级（.say-pill）的字体（UA 默认），显式 inherit 跟上 ——
     整格（placeholder / 打字）一个字体，不和气泡闪面孔（Task 15 复审 M1）。 */
  font-family: inherit;
}

/* placeholder 要单独一个类喂给 input 的 placeholder-class（inline 的 placeholder
   文字不吃普通后代选择器） */
.say-ph {
  color: var(--muted-2);
}

/* 忙态那句「在想…」/「正在修…」 */
.say-thinking {
  color: var(--muted);
  font-size: 28rpx;
}

/* ★ 2026-10-13 真机修复 + Task 14 + 修复轮 F3：输入条那行的「撤销」—— 从画布层
   （照片右下角）搬来这里（真机上叠 webgl canvas 的可点 view 收不到点击，见 README
   「已知平台行为」）。**破坏性动作放左侧**（wxml 里它在 .say-pill 前面，离右手拇指
   主路径最远）。muted 描边风、不抢发送箭头的主色；★ 修复轮 F2：高 80rpx = 输入
   胶囊等高（和发送箭头同尺寸档），出现/消失不会让这一行跳高。
   （「停止」的样式在对话区那段 —— .msg-stop，它跟着生成那颗气泡走。） */
.say-act-undo {
  flex: none;
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-pill);
  color: var(--muted);
  font-size: 26rpx;
}

/* 发送箭头：--accent-400 底、--accent-ink 字（照 mock） */
.say-send {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-left: 20rpx;
  background: var(--accent-400);
  border-radius: 50%;
  color: var(--accent-ink);
  font-size: 40rpx;
  font-weight: 600;
}

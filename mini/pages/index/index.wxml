<view class="page" style="padding-top: {{statusBar}}px">
  <!-- padding-right 让给微信那颗胶囊（••• | ⊙，它画在页面之上）—— 不让位「保存」就被它整个盖住。左边距仍在 wxss 里。 -->
  <view class="topbar" wx:if="{{stage === 'edit'}}" style="padding-right: {{topbarPadRight}}px">
    <view class="tb-left" bindtap="onPickAgain">换一张</view>
    <view class="tb-title">PinkRose</view>
    <view class="tb-right" bindtap="onSave">保存</view>
  </view>

  <view class="empty" wx:if="{{stage === 'empty'}}">
    <image class="brand-mark" src="/assets/emperor-badge.png" />
    <view class="brand-name">PinkRose</view>
    <view class="empty-sub">拍完随手修，30 秒发出去</view>
    <button class="big-btn" bindtap="onCamera">拍一张</button>
    <button class="big-btn ghost" bindtap="onAlbum">从相册选</button>
    <!-- ★ 冒烟用的测试通道（Task 7）：**仅开发版**可见（dev = envVersion 是不是 develop，
         见 index.ts 的 onLoad）。点了把打进包的 assets/test-photo.jpg 走「选完照片」
         的同一条路 —— 绕开系统选图弹窗，automator 才点得动。别改名成看不出用途的词。 -->
    <button class="big-btn ghost dev-btn" wx:if="{{dev}}" bindtap="onDevPhoto">载入测试照片</button>
    <!-- ★ Task 11 的 dev 通道：跑一遍静默登录（getToken：有票就拿、没票就 wx.login →
         换票），成功/失败都 toast 一句人话。给冒烟/真机验收一个"只测登录"的入口
         （「说一句」那条路要等 Task 12）。
         ⚠️ class **故意不叫 dev-btn**：冒烟的哨兵按 `.dev-btn` 找的是上面那颗
         「载入测试照片」（$ 取第一个命中）——别给这颗也挂上，也别调换两行顺序。 -->
    <button class="big-btn ghost dev-login" wx:if="{{dev}}" bindtap="onDevLogin">试一试登录</button>
  </view>

  <view class="edit" wx:if="{{stage === 'edit'}}">
    <!-- 照片区：一块**只有照片**的舞台，照片由渲染管线画在画布里。
         画布的显示尺寸（stageW/stageH，ts 里按照片和这块地方算的等比尺寸）走 inline
         style；绘图缓冲另算（= 照片原尺寸，见 lib/gl/tonePipeline.ts 的 resizeToImage）。
         ★ 四个触摸事件 = 「按住看原图」（Task 8）：按住 150ms 出原图、抬手/被系统
         收走/手指挪走都画回来（契约在 ts 的 PEEK_HOLD_MS）。挂在**整块照片区**上
         （含照片两侧的留白）—— 没挂在画布上是因为这里要的是"照片区"，别改成单个节点。
         ★ Task 14：外面那层 `.stage-wrap` 壳删了（它当初是给生成蒙层/撤销用的，蒙层
         整个搬进了对话区）—— 画布直接留在 stage-area 里，flex 居中照旧。
         ⚠️ 生成中照片上**没有任何蒙层/浮层**（真机上叠 webgl canvas 的可点 view
         收不到点击，见 README「已知平台行为」）；可点的「停止」在对话区那颗气泡里。 -->
    <view class="stage-area" id="stage-area"
          bindtouchstart="onPhotoTouchStart"
          bindtouchmove="onPhotoTouchMove"
          bindtouchend="onPhotoTouchEnd"
          bindtouchcancel="onPhotoTouchCancel">
      <canvas type="webgl2" id="stage" class="stage"
              style="width: {{stageW}}px; height: {{stageH}}px"></canvas>
    </view>

    <!-- 风格栏：横滑，一格一张**真渲染**的小图 + 名字（画法见 lib/image/thumbs.ts）。
         小图是拼在一张 sprite 里的一次性产物，这里用 background-position 切格 ——
         一格一个 canvas 节点在小程序里会卡。sprite 没画好时 styles 是空的，
         这条先空着（版面高度不变，照片区不会跟着跳一下）。
         ⚠️ **别给它加 show-scrollbar / enhanced**：横滑条本来就没出现过（实测）；
         show-scrollbar 单写是惰性的（要配 enhanced 才生效），而 enhanced 会带来别的
         渲染变化、不值当（Task 15 复审 M2；下面对话区那条是真有竖线才开的那一套）。 -->
    <scroll-view class="styles" scroll-x enable-flex="{{true}}">
      <view wx:for="{{styles}}" wx:key="id"
            class="style-cell {{activeStyle === item.id ? 'on' : ''}}"
            data-id="{{item.id}}" bindtap="onStyleTap">
        <view class="style-thumb"
              style="width: {{item.w}}rpx; background-image: url({{spritePath}}); background-size: {{spriteW}}rpx var(--thumb-h); background-position: -{{item.x}}rpx 0"></view>
        <text class="style-name">{{item.label}}</text>
      </view>
    </scroll-view>

    <view wx:if="{{stylePresetId}}" class="style-strength">
      <text>风格强度</text>
      <slider class="style-strength-slider" min="0" max="100" step="1"
              value="{{styleAmount}}" activeColor="#2dd4bf" backgroundColor="#303037"
              block-size="20" bindchange="onStyleAmount" />
      <text class="style-strength-value">{{styleAmount}}</text>
    </view>

    <!-- 工具行永远在画布外。工具面板走正常排版流，不覆盖照片，避免真机上
         WebGL 画布吞掉覆盖层里的点击。 -->
    <view class="tool-row" role="group" aria-label="修图工具">
      <view class="tool-cell {{tool === 'ai' ? 'on' : ''}}" data-tool="ai"
            aria-role="button" bindtap="onToolTap">AI</view>
      <view class="tool-cell {{tool === 'tone' ? 'on' : ''}}" data-tool="tone"
            aria-role="button" bindtap="onToolTap">调色</view>
      <view class="tool-cell {{tool === 'portrait' ? 'on' : ''}}" data-tool="portrait"
            aria-role="button" bindtap="onToolTap">人像</view>
      <view class="tool-cell {{tool === 'crop' ? 'on' : ''}}" data-tool="crop"
            aria-role="button" bindtap="onToolTap">裁剪</view>
      <view class="tool-cell compare" aria-role="button"
            bindtouchstart="onCompareStart" bindtouchend="onCompareEnd"
            bindtouchcancel="onCompareEnd">对比</view>
    </view>

    <view wx:if="{{tool === 'tone'}}" class="edit-panel" aria-label="手动调色">
      <view class="panel-tabs">
        <view class="panel-tab {{toneGroup === 'basic' ? 'on' : ''}}"
              data-group="basic" bindtap="onToneGroup">基础</view>
        <view class="panel-tab {{toneGroup === 'light' ? 'on' : ''}}"
              data-group="light" bindtap="onToneGroup">光线</view>
        <view class="panel-tab {{toneGroup === 'color' ? 'on' : ''}}"
              data-group="color" bindtap="onToneGroup">色彩</view>
      </view>
      <view class="adjust-row" wx:for="{{sliders}}" wx:key="key">
        <view class="adjust-head">
          <text>{{item.label}}</text>
          <text class="adjust-value">{{item.value}}</text>
        </view>
        <slider class="adjust-slider" min="{{item.min}}" max="{{item.max}}" step="1"
                value="{{item.value}}" data-key="{{item.key}}"
                activeColor="#2dd4bf" backgroundColor="#303037" block-size="20"
                bindchanging="onSliderChanging" bindchange="onSliderChange" />
      </view>
      <view class="panel-reset" aria-role="button" bindtap="onResetTool">重置本组</view>
    </view>

    <view wx:if="{{tool === 'portrait'}}" class="edit-panel" aria-label="人像微调">
      <view class="panel-title">肤色与质感</view>
      <view class="adjust-row" wx:for="{{sliders}}" wx:key="key">
        <view class="adjust-head">
          <text>{{item.label}}</text>
          <text class="adjust-value">{{item.value}}</text>
        </view>
        <slider class="adjust-slider" min="{{item.min}}" max="{{item.max}}" step="1"
                value="{{item.value}}" data-key="{{item.key}}"
                activeColor="#2dd4bf" backgroundColor="#303037" block-size="20"
                bindchanging="onSliderChanging" bindchange="onSliderChange" />
      </view>
      <view class="panel-reset" aria-role="button" bindtap="onResetTool">重置人像</view>
    </view>

    <view wx:if="{{tool === 'crop'}}" class="edit-panel" aria-label="裁剪">
      <view class="panel-title">旋转与画幅</view>
      <view class="crop-actions">
        <view class="crop-chip" data-delta="-1" bindtap="onCropRotate">左转 90°</view>
        <view class="crop-chip" data-delta="1" bindtap="onCropRotate">右转 90°</view>
        <view class="crop-chip {{cropFlipH ? 'on' : ''}}" bindtap="onCropFlip">水平翻转</view>
      </view>
      <view class="crop-ratios">
        <view class="crop-chip {{cropRatio === 'original' ? 'on' : ''}}"
              data-ratio="original" bindtap="onCropRatio">原图</view>
        <view class="crop-chip {{cropRatio === '1:1' ? 'on' : ''}}"
              data-ratio="1:1" bindtap="onCropRatio">1:1</view>
        <view class="crop-chip {{cropRatio === '4:5' ? 'on' : ''}}"
              data-ratio="4:5" bindtap="onCropRatio">4:5</view>
        <view class="crop-chip {{cropRatio === '3:4' ? 'on' : ''}}"
              data-ratio="3:4" bindtap="onCropRatio">3:4</view>
        <view class="crop-chip {{cropRatio === '16:9' ? 'on' : ''}}"
              data-ratio="16:9" bindtap="onCropRatio">16:9</view>
      </view>
      <view class="panel-actions">
        <view class="panel-reset" bindtap="onCropCancel">取消</view>
        <view class="panel-primary {{cropping ? 'off' : ''}}" bindtap="onCropApply">
          {{cropping ? '正在裁…' : '完成裁剪'}}
        </view>
      </view>
    </view>

    <!-- 对话区（★ Task 14 / spec §4.2 修订块）：说过的话（me）/ 小皇帝回的（ai）/
         系统小字（note）都留在这，**一律不自动消失**。
         位置：风格栏和输入条**之间**、正常排版流里的一条 scroll-view —— **绝不绝对
         定位叠到照片/画布上**（真机上叠 webgl canvas 的可点 view 收不到点击，见
         README「已知平台行为」）；「停止」跟着生成那颗气泡走，也就同样在画布外。
         没消息时整条不渲染（wx:if），不占地方。
         滚到底：靠条目自己的 id="m{{item.id}}" + ts 的 scrollBottom（它指到最后
         一条；值没变过时先清再指逼出一次值变 —— thinking→done 同一颗气泡长高的
         那个病根）。★ 修复轮试过"交替 id 哨兵"，真运行时滚不动（探针 + 冒烟截图
         钉死），别再改回去。
         封顶 50 条（ts 的 MAX_MSGS，超了从头部丢最老的）。
         点 `.msg-body` = 回填那句话进输入框（★ 修复轮 F4，只有 me 气泡吃这个手势）。
         ★ Task 15（F5）：show-scrollbar="{{false}}" —— 修复轮留的"那条竖线"就是
         滚动条（Task 15 评审像素扫描钉死：对话区内容盒右缘、纵贯整条）。
         ⚠️ **show-scrollbar 单独写不生效**：官方文档原文「滚动条显隐控制
         (同时开启 enhanced 属性后生效)」（开发者工具自带的属性元数据里同一句；
         2026-10-13 只看 show-scrollbar 时像素扫描前后完全一致，证实如此）——
         所以这里一并开 enhanced="{{true}}"（scroll-view 增强特性；scroll-into-view
         照常支持，冒烟 E4「尾巴在折叠线之上」盯着滚动行为）。 -->
    <scroll-view class="msgs" wx:if="{{tool === 'ai' && msgs.length}}" scroll-y scroll-into-view="{{scrollTo}}"
                 enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{msgs}}" wx:key="id" id="m{{item.id}}" class="msg {{item.kind}}">
        <image wx:if="{{item.kind === 'ai'}}" class="msg-badge" src="/assets/emperor-badge.png"
               aria-hidden="true" />
        <view class="msg-body" bindtap="onRecallMsg" data-kind="{{item.kind}}" data-text="{{item.text}}">
          <!-- 生成期那颗气泡就地显示转圈 + 秒表 + 停止（生成中不用改 state ——
               按页面那个 generating 现算；路由那 1.3~1.6 秒显示「在想…」） -->
          <block wx:if="{{item.kind === 'ai' && item.state === 'thinking'}}">
            <view class="msg-spinner"></view>
            <text class="msg-text">{{generating ? genText : '在想…'}}</text>
            <view wx:if="{{generating}}" class="msg-stop"
                  aria-role="button" aria-label="停止" bindtap="onStopGen">停止</view>
          </block>
          <text wx:else class="msg-text">{{item.text}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 说一句（spec §4.2）：胶囊输入条 + 发送箭头（--accent-400 底、--accent-ink 字）。
         发送后输入条先换成「在想…」（路由那 1.3~1.6 秒照片上不弹任何东西；
         过程在对话区），进生成才轮到那颗气泡转起来。
         ★ Task 19：placeholder 走 data 的 sayPh（默认「说一句，比如「天空再蓝一点」」；
         每轮收场后按现行画面拉 /api/suggest 换新）—— **wxml 里就这一个口径**，
         别在模板/别处再拼一套句子（句式框架只有 ts 的 sayPhOf 一份）。 -->
    <view class="say-bar" wx:if="{{tool === 'ai'}}">
      <view class="say-row">
        <!-- ★ 2026-10-13 真机修复 + Task 14 + 修复轮 F3：破坏性动作放左侧 ——
             「撤销」留在这一行、但挪到最左（离右手拇指的主路径/右端发送键最远，防误触）。
             它当初从照片角搬来 —— 真机上叠在 webgl canvas 之上的 view 收不到点击，
             模拟器不复现。忙时（在想…/正在修…）连它一起收 —— 防"点了没反应"
             （ts 里 onUndo 开头还有一条同样的保险）。「停止」已跟着生成那颗气泡搬进
             对话区（.msg-stop）。**别再往回挪**（照片区/蒙层那边真机点不动）。 -->
        <view wx:if="{{canUndo && !sayBusy}}" class="say-act-undo"
              aria-role="button" bindtap="onUndo">撤销</view>
        <view class="say-pill">
          <input wx:if="{{!sayBusy}}" class="say-input" value="{{sayText}}"
                 bindinput="onSayInput" bindconfirm="onSaySend"
                 confirm-type="send" placeholder="{{sayPh}}"
                 placeholder-class="say-ph" />
          <text wx:else class="say-thinking">{{sayBusyText}}</text>
        </view>
        <!-- 忙的时候整颗收掉（不做"看得见点不动"的死按钮） -->
        <view class="say-send" wx:if="{{!sayBusy}}" aria-role="button" aria-label="发送"
              bindtap="onSaySend">↑</view>
      </view>
    </view>
  </view>
</view>

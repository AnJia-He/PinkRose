@import "styles/fonts.wxss"; /* ★ Task 15：内嵌字体（MiSans 子集 + 字标）—— 自动生成物，见该文件头注释；wxss 的 @import 必须放最前 */

/* app.wxss —— 全局深色令牌 + 页面底
   ⚠️ 这是电脑版 `src/styles.css` 深色那半的手工镜像（2026-10-12 抄的，
     每一档都是从那边的 `light-dark(浅, 深)` 里取的**深色那半**）——
     电脑版改色时这里要跟着看一眼，别让它悄悄过期。 */

/* ── 字号映射表（★ Task 15 补，纯注释；改任何字号前先看它）────────────────
   映射口径 = 电脑版九档 × 1.922（750rpx = 390.4px）取偶（评审报告 §3.2）：
     电脑版 30px → 56rpx  空态品牌名
     电脑版 17px → 32rpx  空态两颗大按钮
     电脑版 15px → 30rpx  顶栏三处（换一张 / PinkRose / 保存）
     电脑版 14px → 28rpx  气泡、输入格、空态副句
     电脑版 13px → 26rpx  停止、撤销
     电脑版 12px → 24rpx  系统小字、风格名
     （图标字号，非文字档）→ 40rpx  发送箭头 ↑
   全页字号都应落在这七行里；新字号先有依据（电脑版哪一档），再进样式。 */

page {
  /* ── 中性六档（越抬越亮）───────────────────────────── */
  --bg: #151517;
  --panel: #1e1e21;
  --raised: #26262a;
  --hover: #323238;
  --line: #33333a;
  --line-2: #43434c;
  --line-3: #56565f;
  --photo-edge: rgba(255, 255, 255, .22);
  /* ── 字 ─────────────────────────────────────────────── */
  --text: #f2f2f5;
  --muted: #b9b9c3;
  --muted-2: #a6a6b1;
  --danger: #ff9a8f;
  /* ── 强调色：深色主色是薄荷（电脑版同款）───────────── */
  --accent-300: #5eead4;
  --accent-400: #2dd4bf;
  --accent-500: #5eead4;
  --accent-700: #0f766e;
  --accent-ink: #042f2e;
  --accent-tint: #123330;
  /* 主色那一档的别名（电脑版同款叫法） */
  --accent: var(--accent-400);
  /* ── 圆角（小元件 8~16px 级、胶囊 999）──────────────── */
  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 16px;
  --r-pill: 999px;
  /* ── 间距（同电脑版 --sp-* 那一族）──────────────────── */
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 24px;
  --sp-6: 32px;
  --sp-7: 48px;

  background: var(--bg);
  color: var(--text);
  font-family: "MiSans Mini", -apple-system, "PingFang SC", sans-serif;
  /* ★ Task 15（spec §7）：固定文案全吃 MiSans 子集（上面 @import 那份）——
     子集外的字自动掉系统字体（回退链送的，不出豆腐块）。 */
}

/* ── ★ Task 15 · 字体的两处口径（spec §7）─────────────────────────────
   ① **动态内容显式回系统栈**：用户输入 / 模型回话（`.msg-body`——气泡、系统
      小字都在它里面）和输入格（`.say-pill` + `.say-input`）。⚠️ `<input>` **不吃
      父级字体**（UA 默认），光靠 `.say-pill` 声明到不了它 —— 靠 `.say-input` 里那条
      `font-family: inherit` 跟上（整格一个字体，不会在「placeholder / 打字 /
      在想…」之间闪面孔）。「停止」生在 `.msg-body` 里，跟着一起走系统字体
      （免得同一行两副面孔）。
   ② **「PinkRose」两处 = 字标**（Playfair Display 子集，和落地页顶栏同一个
      写法）：空态 lockup 的 `.brand-name` 和顶栏的 `.tb-title` —— 同一个品牌名
      渲染成两种字体才是味道不对。 */
.msg-body,
.say-pill {
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.brand-name,
.tb-title {
  font-family: "PinkRose Wordmark", "MiSans Mini", -apple-system, "PingFang SC", sans-serif;
}

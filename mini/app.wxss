/* app.wxss —— 全局深色令牌 + 页面底
   ⚠️ 这是电脑版 `src/styles.css` 深色那半的手工镜像（2026-10-12 抄的，
     每一档都是从那边的 `light-dark(浅, 深)` 里取的**深色那半**）——
     电脑版改色时这里要跟着看一眼，别让它悄悄过期。 */
page {
  /* ── 中性六档（越抬越亮）───────────────────────────── */
  --bg: #151517;
  --panel: #1e1e21;
  --raised: #26262a;
  --hover: #323238;
  --line: #33333a;
  --line-2: #43434c;
  --line-3: #56565f;
  --photo-edge: rgba(255, 255, 255, .22);
  /* ── 字 ─────────────────────────────────────────────── */
  --text: #f2f2f5;
  --muted: #b9b9c3;
  --muted-2: #a6a6b1;
  --danger: #ff9a8f;
  /* ── 强调色：深色主色是薄荷（电脑版同款）───────────── */
  --accent-300: #5eead4;
  --accent-400: #2dd4bf;
  --accent-500: #5eead4;
  --accent-700: #0f766e;
  --accent-ink: #042f2e;
  --accent-tint: #123330;
  /* 主色那一档的别名（电脑版同款叫法） */
  --accent: var(--accent-400);
  /* ── 圆角（小元件 8~16px 级、胶囊 999）──────────────── */
  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 16px;
  --r-pill: 999px;
  /* ── 间距（同电脑版 --sp-* 那一族）──────────────────── */
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 24px;
  --sp-6: 32px;
  --sp-7: 48px;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", sans-serif;
}

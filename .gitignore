# 凭证 / 环境变量
.env
.env.*
!.env.example

# 用户测试照片（真实照片不入库）
test-photos/
*.jpg
*.jpeg
*.png
*.webp
*.heic

# 例外：实验证据图要入库（设计文档引用它们，丢了就没法复现结论）
!spike/evidence/*.jpg
!spike/evidence/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
.next/

# TypeScript 增量构建产物（npm run build 的 tsc -b 会在仓库根留下它）
*.tsbuildinfo

# 输出产物
out/
output/
*.out.png

# 编辑器
.vscode/
.idea/
.DS_Store

# SDD 工作区（临时脚手架，不入库）
.superpowers/

# Vite 缓存
.vite/

# 小程序开发者工具生成的「本机私有配置」——微信官方模板默认不入库
# （里面没有任何密钥，纯粹是每台机器不同的编辑器设置）
spike/**/project.private.config.json

# 用户数据：数据库和照片。绝不提交
# ⚠️ 开头的斜杠是**故意的**：写 `data/` 会匹配**任意层级**下叫 data 的目录，
# 而设计 §8 会把素材放进 src/data/ —— 那一天那些文件会被这里**静默忽略**，
# 而且 git status 一声不吭（这正是这个项目最怕的那种"没红就以为没事"）。
/data/
